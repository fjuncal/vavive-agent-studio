# Aplicação
SERVER_PORT=8080

# Banco de dados
DATABASE_URL=jdbc:postgresql://localhost:5432/vavive_agent_studio
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# JPA
JPA_DDL_AUTO=validate
JPA_FORMAT_SQL=true

# Flyway
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

# JWT
JWT_SECRET=change-me
JWT_EXPIRATION_SECONDS=86400

# CORS
APP_ALLOWED_ORIGINS=http://localhost:3000

# Feature flags
APP_FEATURE_REAL_CHANNELS_ENABLED=true
APP_FEATURE_LIVE_INBOX_ENABLED=true
APP_FEATURE_SALES_HANDOFF_ENABLED=true

# GPTMaker
GPTMAKER_BASE_URL=https://api.gptmaker.ai
GPTMAKER_API_TOKEN=change-me
GPTMAKER_MOCK_ENABLED=false

# WhatsApp
VAVIVE_WHATSAPP_PROVIDER=evolution
VAVIVE_WHATSAPP_EVOLUTION_BASE_URL=http://localhost:8081
VAVIVE_WHATSAPP_EVOLUTION_API_KEY=change-me
VAVIVE_WHATSAPP_EVOLUTION_INSTANCE=change-me
VAVIVE_WHATSAPP_EVOLUTION_SEND_PATH=/message/sendText/{instance}

# Webhook do agente
VAVIVE_WEBHOOKS_AGENT_SECRET=change-me